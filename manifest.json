{
  "manifest_version": 3,
  "name": "Job Autofill",
  "version": "1.3.0",
  "description": "Auto-detects and fills common job application form fields from your saved profile.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://web.whatsapp.com/*"
      ],
      "all_frames": true,
      "js": [
        "fieldMap.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
